# Database - Production PostgreSQL (Required for Vercel)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# NextAuth - REQUIRED for production
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Development Database (SQLite)
# DATABASE_URL="file:./dev.db"

# ============================================
# Security & Encryption
# ============================================
SYSTEM_CONFIG_ENCRYPTION_KEY="your-encryption-key-32-chars-min"

# reCAPTCHA v3 (Optional but recommended)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"

# ============================================
# Redis (Upstash) - RECOMMENDED for production
# Used for rate limiting and caching
# ============================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# Vercel Blob - REQUIRED for all managed image uploads on Vercel
# Used by avatars, advertisements, home content, education thumbnails, branding/theme images, and chat uploads
# ============================================
BLOB_READ_WRITE_TOKEN=""

# ============================================
# Error Tracking (Sentry) - RECOMMENDED for production
# ============================================
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ============================================
# Cron Jobs
# ============================================
CRON_SECRET="your-cron-secret-key"

# Facebook API (Optional - will use mock data if not provided)
FACEBOOK_ACCESS_TOKEN="your-facebook-page-access-token"
FACEBOOK_PAGE_ID="your-facebook-page-id"

# ============================================
# OTP / Notifications (Production)
# ============================================

# Email (SMTP) - REQUIRED if you enable EMAIL OTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS/WhatsApp (Twilio) - REQUIRED if you enable SMS/WHATSAPP OTP
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# ============================================
# Logging
# ============================================
LOG_LEVEL="info"

# One-time admin seed for production (scripts/initialize-complete-system.ts)
INIT_ADMIN_EMAIL=""
INIT_ADMIN_PASSWORD=""
